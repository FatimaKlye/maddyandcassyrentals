rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isValidUpload() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Public product images, managed by admins.
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isActiveAdmin() && isValidUpload();
    }

    // Public user avatar/profile images.
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isActiveAdmin()) && isValidUpload();
    }

    // Private, per-booking customer documents: valid IDs, selfie-with-ID,
    // emergency-contact ID, e-signatures, and admin-generated final
    // documents. Never publicly readable. Requires the bookings/{bookingId}
    // doc to already exist (created first in the reservation flow), and the
    // {uid} path segment must match the booking's owner.
    match /private/users/{uid}/bookings/{bookingId}/requirements/{fileName} {
      allow read: if isActiveAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
          firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.userId == uid);
      allow write: if isSignedIn() && request.auth.uid == uid &&
        firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.userId == uid &&
        isValidUpload();
    }

    match /private/users/{uid}/bookings/{bookingId}/signatures/{fileName} {
      allow read: if isActiveAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
          firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.userId == uid);
      allow write: if isSignedIn() && request.auth.uid == uid &&
        firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.userId == uid &&
        isValidUpload();
    }

    // Final customer-facing documents (rental agreement, booking
    // confirmation, pickup/delivery instructions). Generated by the admin
    // approval flow — customers may only ever read their own, never write.
    match /private/users/{uid}/bookings/{bookingId}/documents/{fileName} {
      allow read: if isActiveAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
          firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data.userId == uid);
      allow write: if isActiveAdmin() && isValidUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
