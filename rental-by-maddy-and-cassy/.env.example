NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (use one credential option)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# PayMongo server-only secrets
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_WEBHOOK_SECRET=whsk_
PAYMONGO_PAYMENT_METHODS=card,gcash,grab_pay,paymaya,qrph
APP_URL=https://rentals.example.com

# App Check and Cloud Messaging
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
ENFORCE_FIREBASE_APP_CHECK=false

# Gmail OTP verification (use a Gmail App Password, never your normal password)
GMAIL_SMTP_USER=your-business@gmail.com
GMAIL_SMTP_APP_PASSWORD=
EMAIL_OTP_HMAC_SECRET=

# Private Cloud Storage backup destination
FIREBASE_BACKUP_BUCKET=gs://your-private-backup-bucket
